PORT=8080
NODE_ENV=development

# Publisher type: 'file' (default for development) or 'gcp' (production)
# If not set, defaults to 'file' in development, 'gcp' in production
PUBLISHER_TYPE=file

# For GCP publisher
GCP_PROJECT_ID=your-project-id
PUBSUB_TOPIC=market-articles

# For file publisher (local development)
ARTICLES_OUTPUT_DIR=./articles

# RSS feeds configuration
# Format: JSON array with name and url for each feed
# In .env file, use single quotes around the entire value:
RSS_FEEDS='[{"name":"bloomberg","url":"https://feeds.bloomberg.com/markets/news.rss"},{"name":"cnbc","url":"https://www.cnbc.com/id/100003114/device/rss/rss.html"}]'

# Optional: use local Pub/Sub emulator for development (GCP publisher only)
PUBSUB_EMULATOR_HOST=


