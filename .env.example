PORT=8080
NODE_ENV=development

# Google Cloud Project
GCP_PROJECT_ID=your-project-id
PUBSUB_TOPIC=market-articles

# RSS feeds configuration
# Format: JSON array with name and url for each feed
# In .env file, use single quotes around the entire value, OR escape inner quotes with backslash
# Option 1 (with single quotes - RECOMMENDED):
RSS_FEEDS='[{"name":"bloomberg","url":"https://feeds.bloomberg.com/markets/news.rss"},{"name":"cnbc","url":"https://www.cnbc.com/id/100003114/device/rss/rss.html"}]'

# Option 2 (with escaped double quotes):
# RSS_FEEDS=[{\"name\":\"bloomberg\",\"url\":\"https://feeds.bloomberg.com/markets/news.rss\"}]

# For Cloud Run environment variables, use the JSON directly without quotes:
# --set-env-vars RSS_FEEDS='[{"name":"bloomberg","url":"https://..."}]'

# Optional: use local Pub/Sub emulator for development
PUBSUB_EMULATOR_HOST=

