PORT=8080
NODE_ENV=development

# Google Cloud Project
GCP_PROJECT_ID=your-project-id
PUBSUB_TOPIC=market-articles

# RSS configuration (JSON format)
RSS_FEEDS=[{"name":"cnbc","url":"https://www.cnbc.com/id/100003114/device/rss/rss.html"},{"name":"reuters","url":"https://feeds.reuters.com/reuters/businessNews"},{"name":"ft","url":"https://feeds.ft.com/markets"}]

# Optional: use local Pub/Sub emulator
PUBSUB_EMULATOR_HOST=
