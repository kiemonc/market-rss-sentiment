project_id = "your-gcp-project-id"
region     = "us-central1"

pubsub_topic = "market-articles"

rss_feeds = [
  { name = "cointelegraph", url = "https://cointelegraph.com/rss" },
  { name = "decrypt", url = "https://decrypt.co/feed" },
  { name = "bitcoinmagazine", url = "https://bitcoinmagazine.com/feed" },
  { name = "cryptoslate", url = "https://cryptoslate.com/feed/" },
  { name = "newsbtc", url = "https://www.newsbtc.com/feed/" },
]

schedule            = "0 */6 * * *"
schedule_time_zone  = "Etc/UTC"

allow_unauthenticated = false

# Optional: Firebase Hosting site id for the frontend, must be globally unique.
# Defaults to "<project_id>-frontend" if left unset.
# hosting_site_id = "your-gcp-project-id-frontend"
